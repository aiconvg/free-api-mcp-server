# 复制为 .env 后按需修改；全部变量也可由进程环境注入（PM2/CLI 均可）

# 02 开放层地址（唯一上游）
FREE_API_BASE_URL=https://www.free-api.aiconvg.xin

# 传输形态：stdio | http
MCP_TRANSPORT=stdio

# stdio 模式：优先用户正式令牌（门户自助发牌获得）
# FREE_API_TOKEN=

# stdio 游客模式（免注册试用）：未设 FREE_API_TOKEN 时，回退到内置游客试用令牌
# （TRIAL_LICENSE_TOKEN / TRIAL_LICENSE_TOKEN_FILE，见下方试用层）→ 进入游客模式，
# 每实例每北京日限次免费；由本地文件计数 + 上游 02 游客专用令牌双重兜底。
# TRIAL_LICENSE_TOKEN_FILE=data/.trial_token

# http 模式
MCP_HTTP_PORT=3210
# 允许的 Origin（逗号分隔；留空表示不校验，仅限自有反代之后使用）
# MCP_ALLOWED_ORIGINS=

# —— 试用 / 游客层（托管 HTTP 无令牌 + stdio 游客共用额度口径）——
# 内置游客试用许可证（走 CRM 发牌创建 free 档；仅服务端持有，绝不写进源码 / 公开包）
# TRIAL_LICENSE_TOKEN=
# TRIAL_LICENSE_TOKEN_FILE=data/.trial_token
# 游客每 IP / 每实例每日额度（北京日重置）；只放 3 个可试能力：
#   text_to_speech 30 / speech_to_text 15 / ocr_image 15
# submit_asr_job（长音频异步）、dubbing_*、video_* 游客一律禁用（见 guestGate.js）
# TRIAL_TTS_LIMIT=30
# TRIAL_ASR_LIMIT=15
# TRIAL_OCR_LIMIT=15
# stdio 本地计数（每实例）可单独覆盖（默认与上面三项一致）
# TRIAL_LOCAL_TTS_LIMIT=30
# TRIAL_LOCAL_ASR_LIMIT=15
# TRIAL_LOCAL_OCR_LIMIT=15
# stdio 本地计数文件路径（默认 tmpdir/free-api-mcp-trial-<北京日>.json）
# MCP_LOCAL_COUNTER_FILE=
# 全平台当日试用总次数熔断（北京日；具体上限由部署方按运维配置）
# TRIAL_DAILY_CAP=
# 试用窗口期（小时，IP 首次试用后计时，期内不重发）
# TRIAL_TTL_HOURS=24
# Redis（仅托管 HTTP 试用计数用；fail-closed：不可用即拒绝试用，正式令牌不受影响）
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_DB=1
# 注册引导链接
# TRIAL_SIGNUP_URL=https://www.free-api.aiconvg.xin

# 日志：debug | info | warn | error
LOG_LEVEL=info
