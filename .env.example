# 复制为 .env 后按需修改；全部变量也可由进程环境注入（PM2/CLI 均可）

# 02 开放层地址（唯一上游）
FREE_API_BASE_URL=https://www.open-api.aiconvg.xin

# 传输形态：stdio | http
MCP_TRANSPORT=stdio

# stdio 模式必填：用户的许可证令牌（门户自助发牌获得）
# FREE_API_TOKEN=

# http 模式
MCP_HTTP_PORT=3210
# 允许的 Origin（逗号分隔；留空表示不校验，仅限自有反代之后使用）
# MCP_ALLOWED_ORIGINS=

# —— 试用层（仅托管 HTTP；stdio 不生效）——
# 内置试用许可证（走 CRM 发牌创建 free 档，仅服务端持有；不设置则试用关闭，无令牌一律 401）
# TRIAL_LICENSE_TOKEN=
# 试用额度（按 IP+能力计数）：TTS 10 / ASR 5 / OCR 5（submit_asr_job 与 speech_to_text 共用 ASR 池）
# TRIAL_TTS_LIMIT=3
# TRIAL_ASR_LIMIT=2
# TRIAL_OCR_LIMIT=2
# 全平台当日试用总次数熔断
# TRIAL_DAILY_CAP=200
# 试用窗口期（小时，IP 首次试用后计时，期内不重发）
# TRIAL_TTL_HOURS=24
# Redis（fail-closed：不可用即拒绝试用，正式令牌不受影响）
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_DB=1
# 注册引导链接
# TRIAL_SIGNUP_URL=https://www.free-api.aiconvg.xin

# 日志：debug | info | warn | error
LOG_LEVEL=info
